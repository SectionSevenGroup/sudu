# Every public page loads scripts and styles from its own origin and Google
# Fonts, and nothing else: the pages carry no inline script (JSON-LD is data,
# not executed), inline styles are the site's architecture and are allowed,
# images come from /images and /.netlify/images on this origin, the music from
# /audio, and the contact form and the sketch page POST to "/". The four
# directives at the end close the door on framing, base hijacking and plugins.
#
# This block comes first on purpose. Where a request matches more than one
# rule, the later rule's value for the same header is the one that must win:
# /control/* keeps its own, stricter policy and its no-referrer below, whether
# Netlify replaces the earlier value or sends both.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Control is private. It is never indexed, never cached and never framed, and
# its page may only talk to its own origin.
/control/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'

/.netlify/functions/control
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
